#include "resource.h"

IDI_APP ICON "PenDown.ico"
1 24 "PenDown.manifest"

1 VERSIONINFO
FILEVERSION     1,1,1,0
PRODUCTVERSION  1,1,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "PenDown"
            VALUE "FileDescription",  "PenDown - note taking app"
            VALUE "FileVersion",      "1.1.1.0"
            VALUE "InternalName",     "PenDown"
            VALUE "OriginalFilename", "PenDown.exe"
            VALUE "ProductName",      "PenDown"
            VALUE "ProductVersion",   "1.1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
